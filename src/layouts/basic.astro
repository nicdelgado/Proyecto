---
const {title} = Astro.props
import '../styles/global.css'

import Hero from './partials/Hero.astro'
import Nav from './partials/Nav.astro'
const base = import.meta.env.BASE_URL
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href={`${base}/universidad.png`}>
    <title>{title}</title>
</head>
<body class="bg-[#F3F5F2]">
    <Nav>
    </Nav>
    <Hero>
        <slot/>
    </Hero>
</body>
</html>